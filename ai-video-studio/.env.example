# remote = يعمل عبر Hugging Face (بدون GPU)  |  local = يعمل على جهازك (يحتاج GPU)
MODE=remote
HF_TOKEN=hf_xxxxxxxxxxxxxxxx
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
VIDEO_MODEL=Lightricks/LTX-Video
# نموذج لغوي لتحسين الوصف (اختياري) - أي واجهة متوافقة مع OpenAI (Ollama, vLLM, Groq...)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama3.1
